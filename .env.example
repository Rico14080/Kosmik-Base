# Kosmik Circles production configuration example
# Reference only: server.py reads process environment variables.
# It does not automatically load a .env file. Use your host secret manager.

KOSMIK_HOST=127.0.0.1
KOSMIK_PORT=8080
KOSMIK_ADMIN_PASSWORD=

# V1 defaults to Shop Coming Soon. Set to 1 only when V2 commerce is ready.
KOSMIK_COMMERCE_ENABLED=0

# Payments (required only when enabling Stripe Checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://kosmikcircles.com

# Email (optional for local development, recommended for production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SITE_OWNER_EMAIL=gus@kosmikcircles.com
SMTP_USE_TLS=1

# Optional absolute private persistent storage paths (defaults: backend/data and backend/uploads)
# KOSMIK_DATA_DIR=
# KOSMIK_UPLOAD_DIR=
# Explicit comma-separated proxy IPs allowed to supply X-Forwarded-For (empty trusts none)
KOSMIK_TRUSTED_PROXIES=


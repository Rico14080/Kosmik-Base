# Kosmik Circles production configuration example
# Copy to .env locally; never commit the real file.

KOSMIK_HOST=127.0.0.1
KOSMIK_PORT=8080
KOSMIK_ADMIN_USER=admin
KOSMIK_ADMIN_PASSWORD=change-me

# Payments (required only when enabling Stripe Checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://example.com

# Email (optional for local development, recommended for production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SITE_OWNER_EMAIL=
SMTP_USE_TLS=1

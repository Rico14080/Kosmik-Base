# Kosmik Circles backend configuration
KOSMIK_HOST=127.0.0.1
KOSMIK_PORT=8080
KOSMIK_ADMIN_USER=admin
KOSMIK_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Public HTTPS origin. Required for Stripe Checkout.
PUBLIC_BASE_URL=https://YOUR-DOMAIN.example

# Stripe (leave blank until the account is ready)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP transactional email (optional until configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SITE_OWNER_EMAIL=
